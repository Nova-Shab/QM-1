# Pharma DMS Configuration
# Copy this file to .env and adjust values as needed

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pharma_dms
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/pharma_dms

# Security
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application
DEBUG=true
APP_NAME=Pharma DMS
APP_VERSION=1.0.0

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Document Storage
DOCUMENT_STORAGE_PATH=./document_storage
